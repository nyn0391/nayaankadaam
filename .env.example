# Environment example

# Postgres
POSTGRES_USER=busgo
POSTGRES_PASSWORD=busgo
POSTGRES_DB=busgo_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=replace_me_with_strong_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# Email/SMS/Payment placeholders
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# Spring profiles
SPRING_PROFILES_ACTIVE=dev
